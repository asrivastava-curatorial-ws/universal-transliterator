#!/bin/sh
set -eu

APPDIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)

if [ -n "${XDG_CACHE_HOME:-}" ]; then
    cache_base=$XDG_CACHE_HOME
elif [ -n "${HOME:-}" ]; then
    cache_base=$HOME/.cache
else
    echo "Universal Transliterator: HOME or XDG_CACHE_HOME is required" >&2
    exit 1
fi

cache_dir=$cache_base/universal-transliterator
mkdir -p -- "$cache_dir"
chmod 0700 "$cache_dir" 2>/dev/null || true

app_lib=$APPDIR/usr/lib/x86_64-linux-gnu
loader_dir=$app_lib/gdk-pixbuf-2.0/2.10.0/loaders
loader_cache=$cache_dir/gdk-pixbuf-loaders.cache
loader_query=$app_lib/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders

export LD_LIBRARY_PATH="$app_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export GIO_EXTRA_MODULES="$app_lib/gio/modules"
export GTK_PATH="$app_lib/gtk-4.0"
export FONTCONFIG_FILE=fonts.conf
export FONTCONFIG_PATH="$APPDIR/etc/fonts"
export GSK_RENDERER="${GSK_RENDERER:-cairo}"

if [ -x "$loader_query" ] && [ -d "$loader_dir" ]; then
    loader_tmp=$loader_cache.tmp.$$
    # The cache embeds absolute paths, so it must be generated after the
    # AppImage mount point is known. A same-directory rename is atomic.
    "$loader_query" "$loader_dir"/*.so >"$loader_tmp"
    chmod 0600 "$loader_tmp" 2>/dev/null || true
    mv -f -- "$loader_tmp" "$loader_cache"
    export GDK_PIXBUF_MODULE_FILE="$loader_cache"
fi

export UT_RIME_DATA_DIR="$APPDIR/usr/share/rime-data"
export UT_KKC_DICTIONARY="$APPDIR/usr/share/skk/SKK-JISYO.L"
export UT_KKC_MODEL_METADATA="$app_lib/libkkc/models/sorted3/metadata.json"
export UT_KKC_RULE_METADATA="$APPDIR/usr/share/libkkc/rules/default/metadata.json"
export UT_INDIC_ROOT="$APPDIR/usr/share/universal-transliterator/indic"
export UT_NODE_BINARY="$APPDIR/usr/libexec/universal-transliterator/node"

exec "$APPDIR/usr/bin/universal-transliterator" "$@"
