[Desktop Entry]
Type=Application
Name=Universal Transliterator
GenericName=Offline transliteration editor
Comment=Type in Roman letters and get Unicode text in 42 languages, fully offline
Exec=universal-transliterator %F
Icon=org.universaltransliterator.UniversalTransliterator
Terminal=false
Categories=Utility;TextEditor;GTK;
Keywords=transliteration;transliterator;Unicode;Hindi;Kannada;Tamil;Sanskrit;Pinyin;Japanese;Korean;Indic;keyboard;offline;
MimeType=text/plain;
StartupNotify=true
StartupWMClass=org.universaltransliterator.UniversalTransliterator
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=universal-transliterator --new-window
